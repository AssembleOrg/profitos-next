generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Whitelist {
  id           String   @id @default(cuid())
  email        String   @unique
  isActive     Boolean  @default(true) @map("is_active")
  defaultRole  String   @default("user") @map("default_role")
  // Vistas permitidas (array de hrefs). null = sin configurar (sin acceso).
  // Los admins ignoran esta columna (ven todo).
  allowedViews Json?    @map("allowed_views")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("jp_whitelist")
}

model User {
  id                 String     @id
  email              String     @unique
  fullName           String?    @map("full_name")
  avatarUrl          String?    @map("avatar_url")
  role               String     @default("user")
  googleAccessToken  String?    @map("google_access_token")
  googleRefreshToken String?    @map("google_refresh_token")
  navFavorites       Json?      @map("nav_favorites")
  /// true = foto subida por el usuario (el login con Google no la pisa).
  avatarCustom       Boolean    @default(false) @map("avatar_custom")
  /// [{ label, number, whatsapp }]
  contactPhones      Json       @default("[]") @map("contact_phones")
  /// "Cerrar las demás": sesiones sin fila iniciadas antes de esto no valen.
  sessionsRevokedAt  DateTime?  @map("sessions_revoked_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deviceSessions     UserSession[]
  visitas            Visit[]
  properties         Property[]
  clients            Client[]
  assignedFollowUps  PropertyFollowUp[] @relation("FollowUpAssignedTo")
  createdFollowUps   PropertyFollowUp[] @relation("FollowUpAssignedBy")
  propertyResponsibilities PropertyResponsible[]
  contactCases       ContactCase[]
  buscalaConsultas   BuscalaConsulta[]
  followUpActions    FollowUpAction[]   @relation("FollowUpActionCreatedBy")
  tasaciones           Tasacion[]
  assignedObjectiveCards ObjectiveCard[]   @relation("ObjectiveCardAssignedTo")
  createdObjectiveCards  ObjectiveCard[]   @relation("ObjectiveCardCreatedBy")
  evaluatedObjectiveItems ObjectiveItem[]  @relation("ObjectiveItemEvaluatedBy")
  createdSignatureProposals      SignatureProposal[]       @relation("SignatureProposalCreatedBy")
  createdSignatureProposalActions SignatureProposalAction[] @relation("SignatureProposalActionCreatedBy")
  createdRentalContracts        RentalContract[]            @relation("RentalContractCreatedBy")
  createdRentalPayments         RentalPaymentTransaction[]  @relation("RentalPaymentCreatedBy")
  createdRentalDueDateActions   RentalDueDateAction[]       @relation("RentalDueDateActionCreatedBy")
  createdRentalAdjustments      RentalAdjustment[]          @relation("RentalAdjustmentCreatedBy")
  createdRentalReceipts         RentalReceipt[]             @relation("RentalReceiptCreatedBy")
  voidedRentalReceipts          RentalReceipt[]             @relation("RentalReceiptVoidedBy")
  reviewedServiceProofs         RentalServiceProof[]        @relation("RentalServiceProofReviewedBy")
  createdAccountEntries         AccountEntry[]              @relation("AccountEntryCreatedBy")
  agentAccountEntries           AccountEntry[]              @relation("AccountEntryAgent")
  fundAccountEntries            AccountEntry[]              @relation("AccountEntryFundUser")

  @@map("jp_users")
}

/// Sesión por dispositivo. id = session_id de Supabase Auth.
model UserSession {
  id             String    @id
  userId         String    @map("user_id")
  userAgent      String?   @map("user_agent")
  device         String?
  ip             String?
  locality       String?
  area           String?
  region         String?
  country        String?
  latitude       Float?
  longitude      Float?
  accuracy       Float?
  /// gps | denied | null
  locationSource String?   @map("location_source")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  revokedAt      DateTime? @map("revoked_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("jp_user_sessions")
}

model Property {
  id                String    @id @default(cuid())
  externalId        Int?      @unique @map("external_id")
  source            String    @default("manual")
  address           String
  realAddress       String?   @map("real_address")
  addressComplement String?   @map("address_complement")
  city              String?
  province          String?
  zone              String?
  type              String?   // departamento, casa, local, terreno, oficina, etc
  status            String    @default("activa") // activa, vendida, alquilada, suspendida
  publicationTitle  String?   @map("publication_title")
  referenceCode     String?   @map("reference_code")
  publicUrl         String?   @map("public_url")
  description       String?
  richDescription   String?   @map("rich_description")
  age               Int?
  roomAmount        Int?      @map("room_amount")
  bedrooms          Int?
  bathroomAmount    Int?      @map("bathroom_amount")
  suiteAmount       Int?      @map("suite_amount")
  parkingLotAmount  Int?      @map("parking_lot_amount")
  floorsAmount      Int?      @map("floors_amount")
  orientation       String?
  disposition       String?
  totalSurface      Float?    @map("total_surface")
  roofedSurface     Float?    @map("roofed_surface")
  surface           Float?
  surfaceMeasurement String?  @map("surface_measurement")
  expenses          Float?
  operationType     String?   @map("operation_type")
  operationPrice    Float?    @map("operation_price")
  operationCurrency String?   @map("operation_currency")
  locationFull      String?   @map("location_full")
  locationShort     String?   @map("location_short")
  branchName        String?   @map("branch_name")
  branchOffice      String?   @map("branch_office")
  producerName      String?   @map("producer_name")
  geoLat            Float?    @map("geo_lat")
  geoLong           Float?    @map("geo_long")
  coverImageUrl     String?   @map("cover_image_url")
  photos            Json?
  videos            Json?
  tags              Json?
  extraAttributes   Json?     @map("extra_attributes")
  deletedAt         DateTime? @map("deleted_at")
  externalCreatedAt DateTime? @map("external_created_at")
  externalUpdatedAt DateTime? @map("external_updated_at")
  rawPayload        Json?     @map("raw_payload")
  ownerReportData   Json?     @map("owner_report_data")
  syncAt            DateTime? @map("sync_at")
  userId            String?   @map("user_id")
  user              User?     @relation(fields: [userId], references: [id])
  visitas           Visit[]
  followUps         PropertyFollowUp[]
  tasaciones        Tasacion[]
  signatureProposals SignatureProposal[]
  rentalContracts   RentalContract[]
  accountEntries    AccountEntry[]
  publications      PropertyPublication[]
  internalResponsibles PropertyResponsible[]
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("jp_propiedades")
}

// OAuth por portal (cuenta única de la inmobiliaria).
model PortalToken {
  id           String    @id @default(cuid())
  portal       String    @unique // mercadolibre | zonaprop | adinco
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  externalUser String?   @map("external_user")
  nickname     String?
  scope        String?
  connectedAt  DateTime? @map("connected_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("jp_portal_tokens")
}

// Estado de publicación de una propiedad en un portal.
model PropertyPublication {
  id            String    @id @default(cuid())
  propertyId    String    @map("property_id")
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  portal        String    // mercadolibre | zonaprop | adinco
  externalId    String?   @map("external_id")
  status        String    @default("draft") // draft|publishing|active|paused|closed|error
  permalink     String?
  categoryId    String?   @map("category_id")
  listingTypeId String?   @map("listing_type_id")
  lastPayload   Json?     @map("last_payload")
  lastError     String?   @map("last_error")
  // Cambio de estado que NO pidió el sistema (lo cerró/pausó otro: Tokko, ML).
  externalChangeAt     DateTime? @map("external_change_at")
  externalChangeDetail String?   @map("external_change_detail")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([propertyId, portal])
  @@index([portal, status])
  @@map("jp_property_publications")
}

// Responsables INTERNOS de una propiedad: usuarios de Profitos que reciben las
// notificaciones de consultas (cualquier portal). Independiente de los
// responsables de ZonaProp. Una propiedad puede tener varios.
model PropertyResponsible {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([propertyId, userId])
  @@index([userId])
  @@map("jp_property_responsibles")
}

// Estado de gestión de un CONTACTO de la central de mensajes. La clave es el id
// del mensaje unificado ("portal:rowId"). Sin fila = contacto nuevo/propuesto.
//  - tomado: un usuario lo atiende (primero que llega gana; puede transferir).
//  - espera: apartado con la ✗; si en 3 días nadie lo toma pasa a descartado.
//  - descartado: cerrado sin gestión.
model ContactCase {
  id            String    @id // `${portal}:${rowId}` del inbox
  portal        String
  status        String    // tomado | espera | descartado
  takenByUserId String?   @map("taken_by_user_id")
  takenByUser   User?     @relation(fields: [takenByUserId], references: [id], onDelete: SetNull)
  clientId      String?   @map("client_id")
  followUpId    String?   @map("follow_up_id")
  waitingAt     DateTime? @map("waiting_at") // cuándo entró en espera (para el auto-descarte)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("jp_contact_cases")
}

// Cola de trabajos de publicación. ZonaProp/ArgenProp requieren navegador+proxy
// (solo el worker de Railway los tiene), así que la web ENCOLA y el worker
// procesa en su corrida. MercadoLibre no usa esto (publica sync vía su wizard).
model PublishJob {
  id          String    @id @default(cuid())
  propertyId  String    @map("property_id")
  portal      String // zonaprop | argenprop
  action      String    @default("publish") // publish | pause | close | activate | update
  activate    Boolean   @default(false) // true = publicar ONLINE (gasta crédito); false = solo borrador
  plan        String? // plan de publicación (ej ZonaProp: "3"=Simples) cuando activate
  responsibleUserId String? @map("responsible_user_id") // responsable del aviso (ZonaProp userId)
  status      String    @default("pending") // pending | running | done | error
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([status, portal])
  @@map("jp_publish_jobs")
}

// Preguntas recibidas en publicaciones de portales (leads). Poblado por webhook.
model PortalQuestion {
  id         String    @id @default(cuid())
  portal     String    @default("mercadolibre")
  externalId String    @map("external_id") // id de la pregunta en el portal
  itemId     String    @map("item_id") // MLA... del aviso
  propertyId String?   @map("property_id") // resuelto vía publicación (sin FK)
  text       String
  status     String    @default("UNANSWERED")
  answerText String?   @map("answer_text")
  fromUserId String?   @map("from_user_id")
  askedAt    DateTime? @map("asked_at")
  answeredAt DateTime? @map("answered_at")
  rawPayload Json?     @map("raw_payload")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([portal, externalId])
  @@index([propertyId])
  @@index([itemId])
  @@map("jp_portal_questions")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  attachments Json?
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  visitas   Visit[]
  followUps PropertyFollowUp[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("jp_clientes")
}

model Visit {
  id              String    @id @default(cuid())
  title           String
  description     String?
  attachments     Json?
  date            DateTime
  startTime       String    @map("start_time")
  endTime         String    @map("end_time")
  type            String    @default("visita")
  propertyId      String?   @map("property_id")
  property        Property? @relation(fields: [propertyId], references: [id])
  clientId        String?   @map("client_id")
  client          Client?   @relation(fields: [clientId], references: [id])
  googleEventId   String?   @map("google_event_id")
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("jp_visitas")
}

model PropertyFollowUp {
  id               String           @id @default(cuid())
  title            String?
  notes            String?
  status           String           @default("pendiente")
  dueDate          DateTime?        @map("due_date")
  propertyId       String           @map("property_id")
  property         Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assignedToUserId String           @map("assigned_to_user_id")
  assignedToUser   User             @relation("FollowUpAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  assignedByUserId String           @map("assigned_by_user_id")
  assignedByUser   User             @relation("FollowUpAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  clientId         String?          @map("client_id")
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  actions          FollowUpAction[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("jp_property_followups")
}

model FollowUpAction {
  id              String           @id @default(cuid())
  followUpId      String           @map("followup_id")
  followUp        PropertyFollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  type            String           @default("nota")
  description     String
  actionAt        DateTime         @map("action_at")
  shownToName     String?          @map("shown_to_name")
  scheduledDate   DateTime?        @map("scheduled_date")
  scheduledTime   String?          @map("scheduled_time")
  metadata        Json?
  attachments     Json?
  createdByUserId String           @map("created_by_user_id")
  createdByUser   User             @relation("FollowUpActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@map("jp_followup_actions")
}

model IntegrationSyncState {
  id             String   @id @default(cuid())
  integrationKey String   @unique @map("integration_key")
  lastOffset     Int      @default(0) @map("last_offset")
  lastTotalCount Int      @default(0) @map("last_total_count")
  lastRunAt      DateTime @default(now()) @map("last_run_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("jp_integration_sync_states")
}

model Tasacion {
  id                 String    @id @default(cuid())
  titulo             String
  direccion          String

  // Página 2: Tasación Actualizada
  ubicacionUnidad    String?   @map("ubicacion_unidad")
  superficieTotal    String?   @map("superficie_total")
  superficieMono     String?   @map("superficie_mono")
  condicionVenta     String?   @map("condicion_venta")
  mapaImageUrl       String?   @map("mapa_image_url")

  // Páginas 3+: Fotos
  fotos              Json?

  // Informe + Resultado (rich text HTML)
  informeHtml        String?   @map("informe_html")
  resultadoHtml      String?   @map("resultado_html")

  // Lista de Precios
  listaPreciosTitulo String?   @map("lista_precios_titulo")
  tablas             Json?

  status             String    @default("borrador")
  userId             String    @map("user_id")
  user               User      @relation(fields: [userId], references: [id])
  propertyId         String?   @map("property_id")
  property           Property? @relation(fields: [propertyId], references: [id])
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("jp_tasaciones")
}

model ObjectiveCard {
  id               String          @id @default(cuid())
  title            String
  description      String?
  startDate        DateTime        @map("start_date") @db.Date
  endDate          DateTime        @map("end_date") @db.Date
  statusOverride   String?         @map("status_override")
  assignedToUserId String          @map("assigned_to_user_id")
  assignedToUser   User            @relation("ObjectiveCardAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  createdByUserId  String          @map("created_by_user_id")
  createdByUser    User            @relation("ObjectiveCardCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  items            ObjectiveItem[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([assignedToUserId, startDate, endDate])
  @@index([startDate, endDate])
  @@map("jp_objective_cards")
}

model ObjectiveItem {
  id              String        @id @default(cuid())
  cardId          String        @map("card_id")
  card            ObjectiveCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  text            String
  status          String        @default("pending") // pending | done | failed
  position        Int           @default(0)
  evaluatedByUserId String?     @map("evaluated_by_user_id")
  evaluatedByUser User?         @relation("ObjectiveItemEvaluatedBy", fields: [evaluatedByUserId], references: [id], onDelete: SetNull)
  evaluatedAt     DateTime?     @map("evaluated_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([cardId])
  @@map("jp_objective_items")
}

model SignatureProposal {
  id                 String                    @id @default(cuid())
  propertyId         String                    @map("property_id")
  property           Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Estado actual del proceso
  // propuesta_enviada | propuesta_aceptada | propuesta_rechazada
  // espera_informes | comunicacion_partes_finales | fecha_acordada | entrega_llaves
  status             String                    @default("propuesta_enviada")

  title              String?
  description        String?
  attachments        Json?                     // [{ kind, path, name, size, mime }]

  // Vigencia de la reserva. Son nullable para conservar propuestas históricas;
  // en nuevas altas los tres datos de entrada son obligatorios por API.
  reservationDate        DateTime? @map("reservation_date") @db.Date
  reservationTermDays    Int?      @map("reservation_term_days")
  reservationDayType     String?   @map("reservation_day_type") // business | calendar
  reservationExpiresAt   DateTime? @map("reservation_expires_at") @db.Date

  // Fechas relevantes (todas opcionales)
  dateProcessStarted DateTime?                 @map("date_process_started") // espera_informes
  dateAgreed         DateTime?                 @map("date_agreed")          // fecha_acordada
  dateKeysHandover   DateTime?                 @map("date_keys_handover")   // entrega_llaves

  // IDs de los Visit sincronizados con la agenda (para limpiar al borrar/cambiar)
  visitInformesId    String?                   @map("visit_informes_id")
  visitAcordadaId    String?                   @map("visit_acordada_id")
  visitEntregaId     String?                   @map("visit_entrega_id")

  // Operación con colega: otra inmobiliaria (y su agente) con la que se
  // comparten los honorarios. sharePercent = % de NUESTROS honorarios que se le da.
  withColleague         Boolean  @default(false) @map("with_colleague")
  colleagueAgencyId     String?  @map("colleague_agency_id")
  colleagueAgency       Agency?  @relation(fields: [colleagueAgencyId], references: [id], onDelete: SetNull)
  colleagueName         String?  @map("colleague_name")
  colleagueSharePercent Float?   @map("colleague_share_percent")

  // Datos económicos de la operación: generan los honorarios "a cobrar".
  operationAmount   Float?  @map("operation_amount")
  // ARS | USD
  operationCurrency String  @default("USD") @map("operation_currency")
  // % de honorarios de la inmobiliaria sobre el valor de la operación
  feePercentage     Float?  @map("fee_percentage")
  // Honorarios totales en monto fijo (si viene, manda sobre el %).
  feeAmount         Float?  @map("fee_amount")
  // true = cobramos el total y le pagamos su parte al colega ("a pagar").
  collectsAll       Boolean @default(false) @map("collects_all")
  accountEntries    AccountEntry[]

  createdByUserId    String                    @map("created_by_user_id")
  createdByUser      User                      @relation("SignatureProposalCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  actions            SignatureProposalAction[]
  reservationReminders SignatureReservationReminder[]
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([status])
  @@index([createdByUserId])
  @@index([reservationExpiresAt])
  @@index([withColleague])
  @@map("jp_signature_proposals")
}

model SignatureReservationReminder {
  id           String            @id @default(cuid())
  proposalId   String            @map("proposal_id")
  proposal     SignatureProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  offsetDays   Int               @map("offset_days") // 15 | 5 | 0
  scheduledFor DateTime          @map("scheduled_for") @db.Date
  createdAt    DateTime          @default(now()) @map("created_at")

  @@unique([proposalId, offsetDays])
  @@index([scheduledFor])
  @@map("jp_signature_reservation_reminders")
}

model SignatureProposalAction {
  id              String            @id @default(cuid())
  proposalId      String            @map("proposal_id")
  proposal        SignatureProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  // creation | nota | status_change | date_set
  type            String            @default("nota")
  fromStatus      String?           @map("from_status")
  toStatus        String?           @map("to_status")
  dateField       String?           @map("date_field") // para type=date_set: which date changed
  description     String?
  attachments     Json?

  createdByUserId String            @map("created_by_user_id")
  createdByUser   User              @relation("SignatureProposalActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([proposalId])
  @@index([createdByUserId])
  @@map("jp_signature_proposal_actions")
}

// ────────────────────────────────────────────────────────────────────
// Alquileres temporales
// ────────────────────────────────────────────────────────────────────

model Tenant {
  id          String           @id @default(cuid())
  fullName    String           @map("full_name")
  idType      String           @map("id_type") // dni | cuit
  idNumber    String           @map("id_number")
  phone       String?
  email       String?
  notes       String?
  attachments Json?
  // Portal de inquilinos (cuenta Supabase email + contraseña)
  authUserId        String?          @unique @map("auth_user_id")
  portalEnabled     Boolean          @default(false) @map("portal_enabled")
  portalInvitedAt   DateTime?        @map("portal_invited_at")
  portalLastLoginAt DateTime?        @map("portal_last_login_at")
  contracts   RentalContract[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([fullName])
  @@map("jp_tenants")
}

model Owner {
  id        String           @id @default(cuid())
  fullName  String           @map("full_name")
  idType    String           @default("dni") @map("id_type") // dni | cuit
  idNumber  String?          @map("id_number")
  phone     String?
  email     String?
  notes     String?
  contracts RentalContract[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([fullName])
  @@map("jp_owners")
}

model RentalAdditional {
  id            String                     @id @default(cuid())
  name          String
  defaultAmount Float?                     @map("default_amount")
  notes         String?
  contracts     RentalContractAdditional[]
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  @@map("jp_rental_additionals")
}

model RentalContract {
  id              String                     @id @default(cuid())
  propertyId      String                     @map("property_id")
  property        Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId        String                     @map("tenant_id")
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String?
  startDate       DateTime                   @map("start_date") @db.Date
  endDate         DateTime                   @map("end_date") @db.Date
  // diario | semanal | quincenal | mensual | bimestral | trimestral
  frequency       String
  baseAmount      Float                      @map("base_amount")
  currency        String                     @default("ARS")
  firstDueDate    DateTime                   @map("first_due_date") @db.Date
  gracePeriodDays Int                        @default(0) @map("grace_period_days")
  notes           String?
  attachments     Json?
  // tradicional | temporal (los temporales son legado: se ven, no se crean)
  kind                  String               @default("tradicional")
  // false = lo administra el propietario: legajo sin cuotas, recibos ni avisos
  managed               Boolean              @default(true)
  ownerId               String?              @map("owner_id")
  owner                 Owner?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // Piso y depto / unidad (se imprime en el recibo)
  unit                  String?
  // % de honorarios de administración (default 5, editable en cada cobro)
  feePercent            Float                @default(5) @map("fee_percent")
  dueDay                Int?                 @map("due_day")
  adjustmentEveryMonths Int?                 @map("adjustment_every_months")
  // IPC | ICL | CAC | Casa Propia | Fijo | Otro (texto libre)
  adjustmentIndex       String?              @map("adjustment_index")
  adjustmentNextDate    DateTime?            @map("adjustment_next_date") @db.Date
  // Servicios que paga el inquilino por su cuenta (sube comprobante)
  tenantServices        String[]             @default([]) @map("tenant_services")
  // propietaria | seguro_caucion | recibo_sueldo | otra | ninguna
  guaranteeType         String?              @map("guarantee_type")
  guaranteeDetail       String?              @map("guarantee_detail")
  depositAmount         Float?               @map("deposit_amount")
  advanceAmount         Float?               @map("advance_amount")
  advanceDetail         String?              @map("advance_detail")
  createdByUserId String                     @map("created_by_user_id")
  createdByUser   User                       @relation("RentalContractCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  additionals     RentalContractAdditional[]
  dueDates        RentalDueDate[]
  adjustments     RentalAdjustment[]
  receipts        RentalReceipt[]
  serviceProofs   RentalServiceProof[]
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([tenantId])
  @@index([ownerId])
  @@index([adjustmentNextDate])
  @@index([startDate, endDate])
  @@map("jp_rental_contracts")
}

model RentalContractAdditional {
  id            String                    @id @default(cuid())
  contractId    String                    @map("contract_id")
  contract      RentalContract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  additionalId  String                    @map("additional_id")
  additional    RentalAdditional          @relation(fields: [additionalId], references: [id], onDelete: Cascade)
  amount        Float
  position      Int                       @default(0)
  dueDateLinks  RentalDueDateAdditional[]

  @@index([contractId])
  @@map("jp_rental_contract_additionals")
}

model RentalDueDate {
  id              String                     @id @default(cuid())
  contractId      String                     @map("contract_id")
  contract        RentalContract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  position        Int
  dueDate         DateTime                   @map("due_date") @db.Date
  expectedAmount  Float                      @map("expected_amount")
  // Alquiler de esta cuota (null = baseAmount del contrato). Lo fija un aumento.
  rentAmount      Float?                     @map("rent_amount")
  // null = derivado de fechas; "pagado" | "parcial" | "condonado"
  status          String?
  notes           String?
  additionals     RentalDueDateAdditional[]
  transactions    RentalPaymentTransaction[]
  actions         RentalDueDateAction[]
  serviceProofs   RentalServiceProof[]
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  @@index([contractId])
  @@index([dueDate])
  @@map("jp_rental_due_dates")
}

model RentalDueDateAdditional {
  id                   String                   @id @default(cuid())
  dueDateId            String                   @map("due_date_id")
  dueDate              RentalDueDate            @relation(fields: [dueDateId], references: [id], onDelete: Cascade)
  contractAdditionalId String                   @map("contract_additional_id")
  contractAdditional   RentalContractAdditional @relation(fields: [contractAdditionalId], references: [id], onDelete: Cascade)
  included             Boolean                  @default(true)
  amountOverride       Float?                   @map("amount_override")

  @@unique([dueDateId, contractAdditionalId])
  @@index([dueDateId])
  @@map("jp_rental_due_date_additionals")
}

model RentalPaymentTransaction {
  id               String        @id @default(cuid())
  dueDateId        String        @map("due_date_id")
  dueDate          RentalDueDate @relation(fields: [dueDateId], references: [id], onDelete: Cascade)
  // monto que pagó el inquilino
  amountPaid       Float         @map("amount_paid")
  // comisión que queda para la inmobiliaria
  commissionAmount Float         @default(0) @map("commission_amount")
  // neto al propietario = amountPaid - commissionAmount (denormalizado para reporting)
  ownerAmount      Float         @default(0) @map("owner_amount")
  method           String?
  paidAt           DateTime      @map("paid_at")
  // true = el inquilino paga el total esperado; false = parcial
  isFull           Boolean       @default(true) @map("is_full")
  notes            String?
  attachments      Json?
  // Legado: recibo único previo a los talonarios (v1)
  receiptNumber    Int?          @map("receipt_number")
  receiptPath      String?       @map("receipt_path")
  receiptIssuedAt  DateTime?     @map("receipt_issued_at")
  // % de honorarios aplicado en este cobro y desglose congelado de conceptos
  feePercent       Float?        @map("fee_percent")
  breakdown        Json?
  // Bolsillo donde entró el pago ("caja" | "banco"). null = cobro anterior a la caja.
  fund             String?
  // Rendición al propietario: cuándo retiró su parte y de qué bolsillo salió.
  ownerPaidAt      DateTime?     @map("owner_paid_at")
  ownerPaidFund    String?       @map("owner_paid_fund")
  ownerPaidByUserId String?      @map("owner_paid_by_user_id")
  receipts         RentalReceipt[]
  createdByUserId  String        @map("created_by_user_id")
  createdByUser    User          @relation("RentalPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now()) @map("created_at")

  @@index([dueDateId])
  @@index([paidAt])
  @@index([ownerPaidAt])
  @@map("jp_rental_payment_transactions")
}

model RentalDueDateAction {
  id              String        @id @default(cuid())
  dueDateId       String        @map("due_date_id")
  dueDate         RentalDueDate @relation(fields: [dueDateId], references: [id], onDelete: Cascade)
  // creation | nota | status_change | payment
  type            String        @default("nota")
  fromStatus      String?       @map("from_status")
  toStatus        String?       @map("to_status")
  description     String?
  attachments     Json?
  createdByUserId String        @map("created_by_user_id")
  createdByUser   User          @relation("RentalDueDateActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([dueDateId])
  @@map("jp_rental_due_date_actions")
}

// ────────────────────────────────────────────────────────────────────
// Estados de cuenta (caja/finanzas de la inmobiliaria)
// ────────────────────────────────────────────────────────────────────

model AccountCategory {
  id         String         @id @default(cuid())
  name       String
  // income | expense
  kind       String
  color      String?
  isSystem   Boolean        @default(false) @map("is_system")
  // Área del negocio: "administracion" (alquileres) | "ventas" | null (solo en la vista General)
  area       String?
  sortOrder  Int            @default(0) @map("sort_order")
  archivedAt DateTime?      @map("archived_at")
  entries    AccountEntry[]
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([kind])
  @@map("jp_account_categories")
}

model AccountEntry {
  id              String           @id @default(cuid())
  // income | expense (coincide con el kind de la categoría)
  type            String
  categoryId      String?          @map("category_id")
  category        AccountCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount          Float
  // ARS | USD
  currency        String           @default("ARS")
  // fecha contable del movimiento
  date            DateTime         @db.Date
  description     String?
  agentUserId     String?          @map("agent_user_id")
  agentUser       User?            @relation("AccountEntryAgent", fields: [agentUserId], references: [id], onDelete: SetNull)
  propertyId      String?          @map("property_id")
  property        Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  // Honorarios de la inmobiliaria: % sobre el valor de la operación. Informativo.
  feePercentage   Float?           @map("fee_percentage")
  // Comisión del agente: % sobre el monto del movimiento o monto fijo (agentShareType).
  // En los ingresos con agente se descuenta como egreso automático en el reporte.
  agentPercentage Float?           @map("agent_percentage")
  // "percent" | "amount"
  agentShareType  String           @default("percent") @map("agent_share_type")
  // Marca informativa: ¿el movimiento es compartido?
  isShared        Boolean          @default(false) @map("is_shared")
  // Inmobiliaria con la que se comparte el movimiento (solo si isShared).
  sharedAgencyId  String?          @map("shared_agency_id")
  sharedAgency    Agency?          @relation(fields: [sharedAgencyId], references: [id], onDelete: SetNull)
  // "collected" = movimiento real | "pending" = honorarios a cobrar de una firma
  // (no suma en ingresos ni saldos hasta que se cobra).
  status          String           @default("collected")
  collectedAt     DateTime?        @map("collected_at")
  // Firma que originó los honorarios (a cobrar o ya cobrados).
  signatureProposalId String?      @map("signature_proposal_id")
  signatureProposal   SignatureProposal? @relation(fields: [signatureProposalId], references: [id], onDelete: SetNull)
  // Dónde entró / de dónde salió la plata: "caja" | "banco" | "persona" (fundUserId).
  // null = movimiento anterior a la caja (no suma en los saldos de caja).
  fund            String?
  fundUserId      String?          @map("fund_user_id")
  fundUser        User?            @relation("AccountEntryFundUser", fields: [fundUserId], references: [id], onDelete: SetNull)
  // A quién se le paga / quién paga (texto libre: colega, Octavio, proveedor…).
  counterparty    String?
  // Plan de cuotas: mismas cuotas comparten installmentGroup.
  installmentGroup  String?        @map("installment_group")
  installmentNumber Int?           @map("installment_number")
  installmentCount  Int?           @map("installment_count")
  attachments     Json?
  createdByUserId String           @map("created_by_user_id")
  createdByUser   User             @relation("AccountEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([date])
  @@index([type])
  @@index([categoryId])
  @@index([currency])
  @@index([agentUserId])
  @@index([isShared])
  @@index([sharedAgencyId])
  @@index([status])
  @@index([signatureProposalId])
  @@index([fund])
  @@index([installmentGroup])
  @@map("jp_account_entries")
}

// Otras inmobiliarias con las que se comparten operaciones/movimientos.
model Agency {
  id        String         @id @default(cuid())
  name      String
  address   String?
  phone     String?
  entries   AccountEntry[]
  signatures SignatureProposal[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([name])
  @@map("jp_agencies")
}

// ============================================================================
// Scraper de leads de portales (ZonaProp / ArgenProp).
// Trae las consultas de cada portal por su API interna cada determinado tiempo (por ahora una hora).
// ============================================================================

model ScrapedLead {
  id              String    @id @default(cuid())
  portal          String    // "zonaprop" | "argenprop"
  section         String    // "mensajes" | "telefono" | "whatsapp" | "contactados"
  externalId      String    @map("external_id") // ID único de la consulta en el portal
  contactName     String?   @map("contact_name")
  contactEmail    String?   @map("contact_email")
  contactPhone    String?   @map("contact_phone")
  messageText     String?   @map("message_text")
  messageAt       DateTime? @map("message_at")
  propertyRef     String?   @map("property_ref")     // código/ID del aviso
  propertyTitle   String?   @map("property_title")
  propertyAddress String?   @map("property_address")
  propertyUrl     String?   @map("property_url")
  price           String?
  mapPolygon      Json?     @map("map_polygon")       // zona buscada (extra ZonaProp)
  raw             Json?                                // payload crudo por si falta algo
  scrapedAt       DateTime  @default(now()) @map("scraped_at")

  @@unique([portal, section, externalId]) // dedup a nivel DB
  @@index([portal, section, scrapedAt])
  @@map("jp_scraped_leads")
}

model ScraperSession {
  id           String    @id @default(cuid())
  portal       String    @unique // "zonaprop" | "argenprop"
  storageState Json      @map("storage_state") // cookies/localStorage de Playwright
  valid        Boolean   @default(true)
  lastOkAt     DateTime? @map("last_ok_at")
  // Intentos de re-login AUTOMÁTICO consumidos desde que la sesión se cayó
  // (los hace el worker; se resetea a 0 al loguear OK). Cuando llega al máximo
  // la web pide reconexión manual.
  autoAttempts Int       @default(0) @map("auto_attempts")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("jp_scraper_sessions")
}

// Responsables de publicación por portal (ZonaProp: agentes de la cuenta a los
// que se puede asignar un aviso). Lo refresca el worker (de la respuesta de
// STEP_PLAN_SELECTION al publicar); la web lo lee para el selector.
model PortalResponsibles {
  portal    String   @id // "zonaprop"
  users     Json     @default("[]") // [{ userId, name, lastName, email }]
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("jp_portal_responsibles")
}

// Panel de Difusión: TODOS los avisos de la cuenta en cada portal (los
// publicados desde Profitos y los que vienen de Tokko u otra herramienta), con
// el plan, la calidad y los problemas que informa el portal. Lo llena el worker
// al recorrer los listados (lib/publish/difusion.ts).
model PortalListing {
  id              String    @id @default(cuid())
  portal          String // zonaprop | argenprop
  externalId      String    @map("external_id")
  // Propiedad nuestra (por PropertyPublication o por código de referencia). Sin FK.
  propertyId      String?   @map("property_id")
  code            String?
  title           String?
  address         String?
  url             String?
  pictureUrl      String?   @map("picture_url")
  // Estado crudo del portal (ZP: ONLINE|NEAR_END|OFFLINE|DRAFT|WITHOUT_CREDIT; AP: VIGENTE|RESERVADO|SUSPENDIDO)
  status          String
  published       Boolean   @default(false)
  plan            String? // simple | destacado | superdestacado
  quality         Int? // 0-100 (sólo ZonaProp)
  // [{ rule, level: "error"|"warn", message }]
  issues          Json      @default("[]")
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at")
  // Cuándo apareció el último error nuevo (alimenta la campana de notificaciones).
  issuesChangedAt DateTime? @map("issues_changed_at")
  // Ya no aparece en el listado del portal (archivado / eliminado).
  gone            Boolean   @default(false)
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([portal, externalId])
  @@index([portal, published])
  @@index([propertyId])
  @@map("jp_portal_listings")
}

// Última pasada del panel de Difusión por portal (cuándo, si anduvo, totales del portal).
model PortalDiffusion {
  portal   String   @id
  syncedAt DateTime @default(now()) @map("synced_at")
  ok       Boolean  @default(true)
  error    String?
  // Totales que da el propio portal (ZP: duplicados, denuncias, etc.).
  summary  Json?

  @@map("jp_portal_diffusion")
}

// Estadísticas de cada aviso según el propio portal (ZonaProp: panel
// "Desempeño"). Las trae el worker para el informe al propietario. Sin FK.
model PortalPostingStats {
  id                String    @id @default(cuid())
  portal            String // zonaprop
  externalId        String    @map("external_id")
  propertyId        String?   @map("property_id")
  // Desde que se publicó el aviso.
  totalImpressions  Int?      @map("total_impressions")
  totalVisits       Int?      @map("total_visits")
  totalLeads        Int?      @map("total_leads")
  // Ventana del portal (últimos 30 días).
  periodFrom        DateTime? @map("period_from") @db.Date
  periodTo          DateTime? @map("period_to") @db.Date
  impressions30     Int?      @map("impressions_30")
  visits30          Int?      @map("visits_30")
  leads30           Int?      @map("leads_30")
  contacts30        Int?      @map("contacts_30")
  // { whatsapp, leadForm, viewData, socialAds }
  contactsByChannel Json?     @map("contacts_by_channel")
  // Variación contra los 30 días anteriores: { impressions|visits|leads|contacts: { pct, dir: up|down|equal } }
  trend             Json?
  // Promedio de avisos parecidos (mismo segmento) en 30 días: { impressions, visits, leads }
  segment           Json?
  // Visitas por semana de los últimos 90 días: [{ from, to, impressions, views, leads }]
  weekly            Json?
  fetchedAt         DateTime? @map("fetched_at")
  error             String?
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([portal, externalId])
  @@index([propertyId])
  @@map("jp_portal_posting_stats")
}

// Serie diaria del aviso (se acumula: el portal sólo devuelve 30 días).
model PortalPostingDaily {
  portal      String
  externalId  String   @map("external_id")
  day         DateTime @db.Date
  impressions Int      @default(0)
  views       Int      @default(0)
  leads       Int      @default(0)
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@id([portal, externalId, day])
  @@map("jp_portal_posting_daily")
}

// Cupo de créditos de publicación por portal (ZonaProp: Simple/Destacado/Súper).
// Lo refresca el worker (necesita navegador+sesión); la web lo lee de acá.
model PortalCredits {
  portal    String   @id // "zonaprop"
  plans     Json     @default("[]") // [{ plan, label, available, used, total }]
  raw       Json? // payload crudo del portal, por si hay que reajustar el parseo
  error     String? // último error de refresco (o null)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("jp_portal_credits")
}

// ────────────────────────────────────────────────────────────────────
// Alquileres v2: aumentos, talonarios, recibos, comprobantes
// ────────────────────────────────────────────────────────────────────

model RentalAdjustment {
  id              String         @id @default(cuid())
  contractId      String         @map("contract_id")
  contract        RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  effectiveDate   DateTime       @map("effective_date") @db.Date
  previousAmount  Float          @map("previous_amount")
  newAmount       Float          @map("new_amount")
  indexLabel      String?        @map("index_label")
  notes           String?
  createdByUserId String         @map("created_by_user_id")
  createdByUser   User           @relation("RentalAdjustmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([contractId])
  @@map("jp_rental_adjustments")
}

model ReceiptBook {
  id          String   @id @default(cuid())
  // inquilino | propietario
  kind        String   @unique
  label       String
  pointOfSale Int      @default(1) @map("point_of_sale")
  nextNumber  Int      @default(1) @map("next_number")
  configured  Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("jp_receipt_books")
}

model RentalReceipt {
  id              String                    @id @default(cuid())
  bookKind        String                    @map("book_kind")
  pointOfSale     Int                       @map("point_of_sale")
  number          Int
  // emitido | anulado
  status          String                    @default("emitido")
  transactionId   String?                   @map("transaction_id")
  transaction     RentalPaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  contractId      String?                   @map("contract_id")
  contract        RentalContract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  amount          Float?
  pdfPath         String?                   @map("pdf_path")
  issuedAt        DateTime?                 @map("issued_at")
  voidReason      String?                   @map("void_reason")
  voidedAt        DateTime?                 @map("voided_at")
  voidedByUserId  String?                   @map("voided_by_user_id")
  voidedByUser    User?                     @relation("RentalReceiptVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?                   @map("created_by_user_id")
  createdByUser   User?                     @relation("RentalReceiptCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime                  @default(now()) @map("created_at")

  @@unique([bookKind, pointOfSale, number])
  @@index([transactionId])
  @@index([contractId])
  @@index([issuedAt])
  @@map("jp_rental_receipts")
}

model RentalServiceProof {
  id               String         @id @default(cuid())
  contractId       String         @map("contract_id")
  contract         RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  dueDateId        String?        @map("due_date_id")
  dueDate          RentalDueDate? @relation(fields: [dueDateId], references: [id], onDelete: SetNull)
  service          String
  // YYYY-MM
  period           String
  amount           Float?
  attachments      Json           @default("[]")
  notes            String?
  // pendiente | aprobado | rechazado
  status           String         @default("pendiente")
  reviewNote       String?        @map("review_note")
  reviewedByUserId String?        @map("reviewed_by_user_id")
  reviewedByUser   User?          @relation("RentalServiceProofReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?      @map("reviewed_at")
  uploadedByTenant Boolean        @default(true) @map("uploaded_by_tenant")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([contractId])
  @@index([status])
  @@map("jp_rental_service_proofs")
}

/// Historial local de consultas de personas (informes de Buscala) hechas desde
/// Profitos. Buscala no distingue agentes (todas las consultas del partner van
/// a un único usuario de servicio), así que el "quién consultó qué" vive acá.
model BuscalaConsulta {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier      String
  kind            String
  buscalaReportId String   @map("buscala_report_id")
  label           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("jp_buscala_consultas")
}

// Web pública: quien entra con Google. Separado de jp_users: nunca da acceso al sistema.
model WebVisitor {
  id               String    @id @default(cuid())
  googleSub        String    @unique @map("google_sub")
  email            String
  name             String?
  pictureUrl       String?   @map("picture_url")
  phone            String?
  phoneAskCount    Int       @default(0) @map("phone_ask_count")
  phoneLastAskedAt DateTime? @map("phone_last_asked_at")
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  termsAcceptedAt  DateTime? @map("terms_accepted_at")
  loginCount       Int       @default(0) @map("login_count")
  firstLoginAt     DateTime  @default(now()) @map("first_login_at")
  lastLoginAt      DateTime  @default(now()) @map("last_login_at")
  isInternal       Boolean   @default(false) @map("is_internal")
  favorites        Json      @default("[]")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  events           WebEvent[]

  @@index([email])
  @@map("jp_web_visitors")
}

// Web pública: lo que pasa en la web. Sin IP. Los datos de la propiedad quedan
// copiados al momento del evento para que el historial no cambie con el catálogo.
model WebEvent {
  id           String    @id @default(cuid())
  clientId     String    @unique @map("client_id")
  anonId       String    @map("anon_id")
  sessionId    String    @map("session_id")
  visitorId    String?   @map("visitor_id")
  visitor      WebVisitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  type         String
  path         String?
  propertyKey  String?   @map("property_key")
  address      String?
  operation    String?
  propertyType String?   @map("property_type")
  zone         String?
  price        Float?
  currency     String?
  query        String?
  filters      Json?
  resultsCount Int?      @map("results_count")
  durationMs   Int?      @map("duration_ms")
  scrollDepth  Int?      @map("scroll_depth")
  label        String?
  device       String?
  browser      String?
  channel      String?
  referrerHost String?   @map("referrer_host")
  utmSource    String?   @map("utm_source")
  utmCampaign  String?   @map("utm_campaign")
  isBot        Boolean   @default(false) @map("is_bot")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([createdAt, type])
  @@index([anonId, createdAt])
  @@index([visitorId, createdAt])
  @@index([propertyKey, createdAt])
  @@map("jp_web_events")
}

// Movimientos entre bolsillos (retiros, depósitos) y ajustes de saldo (arqueo).
// Bolsillo = "caja" | "banco" | "persona" (+ userId).
model CashTransfer {
  id              String    @id @default(cuid())
  // transfer | adjust
  kind            String
  fromFund        String?   @map("from_fund")
  fromUserId      String?   @map("from_user_id")
  toFund          String    @map("to_fund")
  toUserId        String?   @map("to_user_id")
  // transfer: siempre > 0. adjust: diferencia (puede ser negativa).
  amount          Float
  currency        String    @default("ARS")
  date            DateTime  @db.Date
  description     String?
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([date])
  @@index([toFund])
  @@index([fromFund])
  @@map("jp_cash_transfers")
}
